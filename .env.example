# =============================================================================
# Vindobona II — Public site (vb-www) Environment Configuration
# =============================================================================
# DE: Kopiere diese Datei zu ".env" (oder ".env.local") und passe die Werte
#     für deine Umgebung an. Vite liest zur Build-/Dev-Zeit nur Variablen
#     mit dem Präfix "VITE_" ein — sie landen im Browser-Bundle und sind
#     damit öffentlich sichtbar. Niemals Secrets hier hineinschreiben!
# EN: Copy this file to ".env" (or ".env.local") and adjust the values for
#     your environment. Vite only picks up variables prefixed with
#     "VITE_" at build/dev time — they end up in the browser bundle and
#     are therefore public. Never put secrets in here!

# DE: Welche Stage diese Instanz darstellt. VERPFLICHTEND — fehlt sie oder
#     ist ihr Wert ungültig, bricht sowohl "npm run dev" als auch der
#     Docker-Prod-Build sofort ab (siehe vite.env-check.ts). Gültige Werte:
#     development, test, qa, production. Ist der Wert "production", ist
#     VITE_API_BASE_URL optional (siehe unten); bei jedem anderen Wert wird
#     sie ebenfalls verpflichtend.
# EN: Which stage this instance represents. MANDATORY — if unset or
#     invalid, both "npm run dev" and the Docker prod build abort
#     immediately (see vite.env-check.ts). Valid values: development,
#     test, qa, production. When set to "production", VITE_API_BASE_URL
#     becomes optional (see below); for any other value it becomes
#     mandatory too.
VITE_APP_ENVIRONMENT=development

# DE: Basis-URL des vb-api-Backends. Gilt ausschließlich für "npm run dev"
#     bzw. einen lokalen "npm run build" (immer eine andere Origin als
#     diese Seite). HINWEIS: Im Produktions-Docker-Image wird diese
#     Variable NICHT mehr verwendet und NICHT mehr fest ins JS-Bundle
#     einkompiliert — dort gilt stattdessen die Laufzeit-Variable
#     API_BASE_URL (ohne VITE_-Präfix), die der Container-Entrypoint bei
#     jedem Container-Start aus der echten Umgebung in config.js schreibt
#     (siehe docker/docker-entrypoint.d/40-generate-runtime-config.sh).
# EN: Base URL of the vb-api backend. Applies only to "npm run dev" or a
#     local "npm run build" (always a different origin than this site).
#     NOTE: In the production Docker image this variable is NOT used
#     anymore and is NOT baked into the JS bundle — production instead
#     uses the runtime variable API_BASE_URL (no VITE_ prefix), which the
#     container entrypoint writes into config.js from the real
#     environment on every container start (see
#     docker/docker-entrypoint.d/40-generate-runtime-config.sh).
VITE_API_BASE_URL=http://localhost:20000/api
